    <string name="app_name">タイピングペット</string>

    <string name="title_settings">🐾 タイピングペット 設定</string>

    <string name="section_permission">権限とペットの表示</string>
    <string name="btn_overlay">① 他のアプリの上に表示を許可</string>
    <string name="btn_accessibility">② アクセシビリティ設定を開く</string>
    <string name="btn_show_pet">③ ペットを表示する</string>

    <string name="tab_basic">基本設定</string>
    <string name="tab_preset">プリセット</string>
    <string name="tab_image">イラスト</string>

    <string name="label_size">サイズ</string>
    <string name="size_small">小</string>
    <string name="size_medium">中</string>
    <string name="size_large">大</string>
    <string name="size_xlarge">特大</string>

    <string name="label_shake">揺れの強さ</string>
    <string name="desc_shake">タイピング時にペットが揺れる度合いです。「なし」は動かず画像だけ切り替わります。</string>
    <string name="shake_none">なし</string>
    <string name="shake_1">1段階</string>
    <string name="shake_2">2段階</string>
    <string name="shake_3">3段階</string>

    <string name="label_display">表示</string>
    <string name="switch_always_on_top_title">常に最前面に固定</string>
    <string name="switch_always_on_top_desc">ONだと他のアプリを開いたときも自動でペットが現れます。OFFだと③ボタンを押した時だけ表示されます。</string>
    <string name="switch_lock_title">位置ロック(タップを素通し)</string>
    <string name="switch_lock_desc">ONにするとタップが下のアプリに通り抜け、ドラッグで動かせなくなります。</string>
    <string name="btn_reset_pos">位置を初期化</string>

    <string name="label_builtin_color">内蔵カラー</string>
    <string name="desc_builtin_color">イラストタブで画像を追加していない間は、ここで選んだ色が使われます。</string>
    <string name="label_selected">選択中</string>
    <string name="label_select">選ぶ</string>

    <string name="btn_remove">削除</string>


    <string name="label_icon_section">ホーム画面のアイコン(任意)</string>
    <string name="desc_icon_section">Androidの仕組み上、アプリ本体のアイコンは後から書き換えられません。代わりに、選んだ画像を使ったショートカットをホーム画面に追加できます。追加後はそちらのアイコンからアプリを開いてください。</string>
    <string name="btn_add_icon_shortcut">画像を選んでホーム画面に追加</string>
    <string name="toast_icon_not_supported">この端末はホーム画面へのアイコン追加に対応していません</string>

    <string name="label_idle">待機イラスト</string>
    <string name="btn_add_image">＋ 画像を追加(複数選択OK)</string>
    <string name="btn_add_image_hint">＋ 画像を追加(GIF・アニメーションWebP もOK)</string>
    <string name="empty_hint">まだ画像がありません</string>
    <string name="desc_idle">入力していない時に表示されます。複数登録すると、待機に戻るたびにランダムで1枚選ばれます。未登録ならタイピング中の1番目の画像(なければ内蔵カラー)を使います。</string>
    <string name="label_steps">タイピング中イラスト(順番)</string>
    <string name="desc_steps">入力中は 1番目 → 2番目 → 3番目… の順に切り替わり、最後まで行くと1番目に戻ります。同じ番号に別パターンを追加すると、その番号のときにランダムで1枚選ばれます。</string>
    <string name="step_label">%1$d番目</string>
    <string name="btn_add_variant">＋ 別パターンを追加</string>
    <string name="btn_add_step">＋ 次の番号を追加</string>
    <string name="btn_delete_step">この番号を削除</string>
    <string name="label_triggers">文字で切り替え(任意)</string>
    <string name="desc_triggers">登録した文字を入力した瞬間、その画像からランダムで1枚表示されます。1つのイラストに複数の文字を割り当てられます(例:「あ」「う」でどよーん)。全角と半角は別の文字として扱います。入力内容は保存・送信せず、入力した位置の直前数文字に登録文字があるかをその場で照合するだけです。</string>
    <string name="trigger_keys_label">反応する文字: %1$s</string>
    <string name="key_format">「%1$s」</string>
    <string name="btn_edit_keys">文字を編集</string>
    <string name="btn_add_trigger">＋ 文字の反応を追加</string>
    <string name="dialog_keys_title">反応する文字</string>
    <string name="dialog_keys_hint">例: あ う (スペース区切りで複数OK)</string>
    <string name="btn_ok">OK</string>
    <string name="btn_cancel">キャンセル</string>
    <string name="toast_keys_empty">文字を1つ以上入力してください</string>
    <string name="label_chars">キャラ</string>
    <string name="desc_chars">イラスト(待機・タイピング中・文字で切り替え)と内蔵カラーを、キャラごとに保存できます。イラストタブでの編集は「編集中」のキャラに反映されます。</string>
    <string name="char_default_name">キャラ %1$d</string>
    <string name="label_in_use">(編集中)</string>
    <string name="btn_use">編集する</string>
    <string name="btn_rename">名前変更</string>
    <string name="btn_add_char">＋ 新しいキャラ(空っぽ)</string>
    <string name="btn_dup_char">＋ 使用中のキャラを複製</string>
    <string name="dialog_char_name_title">キャラの名前</string>
    <string name="copy_suffix">%1$sのコピー</string>
    <string name="confirm_delete_char">「%1$s」を削除しますか？</string>
    <string name="toast_last_char">最後の1体は削除できません</string>
    <string name="switch_shadow_title">足元の影を表示</string>
    <string name="switch_shadow_desc">ペットの足元に出る薄い影です。透過PNGのイラストで影が気になる場合はOFFにしてください。</string>
    <string name="label_show_chars">表示するキャラ</string>
    <string name="desc_show_chars">タップで表示／非表示を切り替え。表示中のキャラは、画面上でそれぞれドラッグして動かせます。</string>
    <string name="show_count">%1$d体表示中</string>
    <string name="key_delete">⌫ 消したとき</string>
    <string name="key_space">␣ スペース</string>
    <string name="key_enter">⏎ 改行</string>
    <string name="key_paste">📋 貼り付け</string>
    <string name="btn_add_delete_trigger">＋ ⌫ 消したときの反応を追加</string>
    <string name="btn_add_space_trigger">＋ ␣ スペースの反応を追加</string>
    <string name="btn_add_enter_trigger">＋ ⏎ 改行の反応を追加</string>
    <string name="btn_add_paste_trigger">＋ 📋 貼り付けの反応を追加</string>
    <string name="notif_channel">ペットの表示</string>
    <string name="notif_text">ペットを表示中</string>
    <string name="pick_image_title">画像を選ぶアプリ</string>
    <string name="toast_import_failed">読み込めなかった画像があります</string>
    <string name="perm_ok">✓ OK</string>
    <string name="perm_set">設定する ›</string>
    <string name="accessibility_description">ペットが入力に反応するために使います。入力欄の文字が変わったことだけを見て、内容の保存・送信は行いません。パスワード欄は見ません。</string>
    <string name="label_detect">入力検知の互換設定</string>
    <string name="desc_detect">アプリによって入力の通知の出し方が違います。反応しないアプリがあるときだけ切り替えてください。</string>
    <string name="switch_selection_title">カーソル移動でも反応させる</string>
    <string name="switch_selection_desc">文字変化を送らずカーソル位置だけ送るアプリ(WebViewなど)向け。ONにすると二重に反応するアプリがあります。</string>
    <string name="switch_enter_submit_title">送信ボタンを改行として扱う</string>
    <string name="switch_enter_submit_desc">単一行の入力欄でIMEの送信/検索を押すと、改行は入らず入力欄が空になります。それを改行とみなします。</string>
    <string name="label_backup">バックアップ</string>
    <string name="desc_backup">キャラ・イラスト・設定をまとめて1つのファイルに保存できます。機種変更や入れ直しの前にどうぞ。</string>
    <string name="btn_backup_export">バックアップを保存</string>
    <string name="btn_backup_import">バックアップから復元</string>
    <string name="toast_backup_ok">バックアップしました（画像 %1$d 枚）</string>
    <string name="toast_restore_ok">復元しました（画像 %1$d 枚）</string>
    <string name="toast_backup_failed">失敗しました: %1$s</string>
    <string name="confirm_restore">今の設定と画像を、バックアップの内容で上書きします。よろしいですか？</string>
    <string name="backup_pick_title">バックアップの保存先</string>
    <string name="restore_pick_title">バックアップファイルを選ぶ</string>
    <string name="label_paste_min">貼り付けと判定する文字数</string>
    <string name="desc_paste_min">一度にこれだけの文字が入ったら貼り付けとみなします。小さいと反応しやすいですが、拼音にスペースを入れる入力法では誤反応しやすくなります。</string>
    <string name="key_copy">📄 コピーしたとき</string>
    <string name="btn_add_copy_trigger">＋ 📄 コピーの反応を追加</string>
    <string name="desc_copy_limit">※ コピーは「選択メニューのコピーボタン」を押したことを見て判定します。クリップボードの中身は読みません（Android 10 以降、一般のアプリは読めません）。</string>
    <string name="switch_copy_selection_title">選択のたたみでもコピーとみなす</string>
    <string name="switch_copy_selection_desc">ONにすると、選択メニューを使わずに選択を終えた場合もコピーとして反応します。素早いスクロール選択でも誤反応しやすくなります。</string>
    <string name="switch_debug_title">検知の記録を取る</string>
    <string name="switch_debug_desc">コピーなどが反応しないときの調査用です。受け取ったイベントの種類とラベルを端末内に記録します。外部には送信しません。</string>
    <string name="btn_show_debug">記録を見る</string>
    <string name="btn_clear_debug">記録を消す</string>
    <string name="debug_empty">まだ記録がありません。ONにしてから、コピーなどを試してみてください。</string>
    <string name="debug_cleared">記録を消しました</string>
    <string name="btn_share_debug">記録を共有</string>
    <string name="switch_ime_title">入力法の候補バーでも反応させる</string>
    <string name="switch_ime_desc">中国語など、確定するまで入力欄に文字が入らない入力法でも、打鍵に反応するようになります。入力内容は読みません。</string>
</resources>