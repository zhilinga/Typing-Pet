    <string name="key_space">␣ 스페이스</string>
    <string name="key_enter">⏎ 줄바꿈</string>
    <string name="key_paste">📋 붙여넣기</string>
    <string name="btn_add_delete_trigger">+ ⌫ 지울 때 반응 추가</string>
    <string name="btn_add_space_trigger">+ ␣ 스페이스 반응 추가</string>
    <string name="btn_add_enter_trigger">+ ⏎ 줄바꿈 반응 추가</string>
    <string name="btn_add_paste_trigger">+ 📋 붙여넣기 반응 추가</string>
    <string name="notif_channel">펫 표시</string>
    <string name="notif_text">펫 표시 중</string>
    <string name="pick_image_title">이미지를 고를 앱</string>
    <string name="toast_import_failed">불러오지 못한 이미지가 있습니다</string>
    <string name="perm_ok">✓ OK</string>
    <string name="perm_set">설정 ›</string>
    <string name="accessibility_description">펫이 입력에 반응하기 위해 사용합니다. 입력란의 문자가 바뀐 것만 확인하며 내용을 저장하거나 전송하지 않습니다. 비밀번호 입력란은 보지 않습니다.</string>
    <string name="label_detect">입력 감지 호환 설정</string>
    <string name="desc_detect">앱마다 입력을 알리는 방식이 다릅니다. 반응하지 않는 앱이 있을 때만 바꿔 주세요.</string>
    <string name="switch_selection_title">커서 이동에도 반응</string>
    <string name="switch_selection_desc">문자 변화 대신 커서 위치만 보내는 앱(WebView 등)용. 일부 앱에서는 두 번 반응할 수 있습니다.</string>
    <string name="switch_enter_submit_title">보내기 버튼을 줄바꿈으로 처리</string>
    <string name="switch_enter_submit_desc">한 줄 입력란에서 IME 보내기/검색을 누르면 줄바꿈 없이 입력란이 비워집니다. 그것을 줄바꿈으로 봅니다.</string>
    <string name="label_backup">백업</string>
    <string name="desc_backup">캐릭터·이미지·설정을 하나의 파일로 저장할 수 있습니다. 기기 변경이나 재설치 전에 사용하세요.</string>
    <string name="btn_backup_export">백업 저장</string>
    <string name="btn_backup_import">백업에서 복원</string>
    <string name="toast_backup_ok">백업했습니다 (이미지 %1$d장)</string>
    <string name="toast_restore_ok">복원했습니다 (이미지 %1$d장)</string>
    <string name="toast_backup_failed">실패했습니다: %1$s</string>
    <string name="confirm_restore">지금 설정과 이미지를 백업 내용으로 덮어씁니다. 진행할까요?</string>
    <string name="backup_pick_title">백업 저장 위치</string>
    <string name="restore_pick_title">백업 파일 선택</string>
    <string name="label_paste_min">붙여넣기로 판단할 글자 수</string>
    <string name="desc_paste_min">한 번에 이만큼의 글자가 들어오면 붙여넣기로 봅니다. 작을수록 반응하기 쉽지만, 병음에 공백을 넣는 입력기에서는 오반응이 늘어납니다.</string>
    <string name="key_copy">📄 복사했을 때</string>
    <string name="btn_add_copy_trigger">+ 📄 복사 반응 추가</string>
    <string name="desc_copy_limit">※ 복사는 문자를 선택해 복사했을 때 선택이 접히는 것으로 판정합니다. Android 10 이상에서는 클립보드를 읽을 수 없어 붙여넣기 쪽에서는 감지할 수 없습니다.</string>
</resources>