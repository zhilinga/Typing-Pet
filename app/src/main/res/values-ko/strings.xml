    <string name="app_name">타이핑펫</string>

    <string name="title_settings">🐾 타이핑펫 설정</string>

    <string name="section_permission">권한 및 펫 표시</string>
    <string name="btn_overlay">① 다른 앱 위에 표시 허용</string>
